# Upload to /home/enroll/public_html/.htaccess  (owner: enroll, mode 644)
#
# React Router serves /courses, /admin-login, /admin-control and others from
# index.html. Without this every deep link and every page refresh is a 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------------------------------------------------------------------
  # These two exclusions look redundant. They are not. Do not delete them.
  #
  # cPanel applies a parent .htaccess to nested subdomain docroots, and
  # api.enroll.lilbrahmas.org's docroot lives INSIDE this one. Without these,
  # the catch-all below swallows AutoSSL's ACME validation fetch for BOTH
  # hostnames, hands Let's Encrypt an HTML page instead of the token, and the
  # certificates expire ~90 days later with no warning at all.
  #
  # Same failure mode as the coturn certificate expiry (addendum section 7):
  # silent, delayed, and total.
  # ---------------------------------------------------------------------
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^api\.enroll\.lilbrahmas\.org/ - [L]

  # Real files and directories are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite emits content-hashed asset filenames, so these can be cached forever.
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|png|jpe?g|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Video lives in public/, so Vite copies it through WITHOUT a content hash --
  # the filename does not change when the file does. "immutable" would therefore
  # pin viewers to an old cut permanently. A week is long enough to matter (the
  # largest of these is 59 MB) and short enough to recover from.
  <FilesMatch "\.(mp4|webm|mov)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HLS playlists must stay fresh; the segments they point at are immutable.
  <FilesMatch "\.m3u8$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # These must never be cached, or clients pin to a stale bundle after a deploy.
  <FilesMatch "^(index\.html|manifest\.webmanifest|sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
